{
  "name": "poietica",
  "version": "0.4.0",
  "private": true,
  "description": "Poietica — a local-first AI agent desktop environment for thinking, describing, and creating.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaojianc916/poietica.git"
  },
  "bugs": {
    "url": "https://github.com/xiaojianc916/poietica/issues"
  },
  "homepage": "https://github.com/xiaojianc916/poietica#readme",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "audit": "bun audit --audit-level=high",
    "audit:rust": "cargo deny check --all-features",
    "agent:prepare": "bun run tools/agent/prepare-runtime.ts",
    "bench:open": "bun run tests/benchmark/open-conversation.bench.ts",
    "bench:reads": "bun run tests/benchmark/reads.bench.ts",
    "build:debug": "bun run agent:prepare && bun run --filter @poietica/desktop electron:build",
    "build:release": "bun run agent:prepare && bun run native:build:release && bun run --filter @poietica/desktop electron:build && bun run --filter @poietica/desktop electron:package",
    "build:web": "turbo run build",
    "check": "bun run check:web && bun run check:rust",
    "check:rust": "cargo fmt --all -- --check && bun run clippy && bun run test:rust && bun run ipc:check",
    "check:versions": "bun tools/release/check-versions.ts",
    "check:web": "biome ci . && bun tools/architecture/verify.ts && turbo run typecheck test --continue",
    "clean": "bun tools/dev/clean.ts",
    "clippy": "CARGO_INCREMENTAL=0 cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "dev": "bun run agent:prepare && bun run --filter @poietica/desktop electron:dev",
    "format": "biome format --write .",
    "ipc:check": "bun tools/contract/check-generated.ts",
    "ipc:generate": "bun tools/contract/generate-ipc.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "latest-json": "bun tools/release/latest-json.ts",
    "prepare": "bun tools/dev/install-git-hooks.ts",
    "release": "bun tools/release/release.ts",
    "test": "turbo run test",
    "test:architecture": "bun tools/architecture/verify.ts",
    "test:rust": "cargo test --workspace --all-features",
    "typecheck": "turbo run typecheck --continue",
    "verify:channel": "bun tools/release/verify-channel.ts",
    "version:set": "bun tools/release/set-version.ts",
    "native:build:release": "bun run tools/dev/build-native.ts --release"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/typescript6": "catalog:",
    "electron": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tests",
      "tools"
    ],
    "catalog": {
      "@base-ui/react": "^1.8.0",
      "@biomejs/biome": "^2.5.14",
      "@oh-my-pi/pi-coding-agent": "18.3.0",
      "@oh-my-pi/pi-tui": "18.3.0",
      "@streamdown/cjk": "^1.0.3",
      "@streamdown/code": "^1.1.1",
      "@streamdown/math": "^1.0.2",
      "@streamdown/mermaid": "^1.0.2",
      "@tailwindcss/vite": "^4.3.3",
      "@tanstack/react-virtual": "^3.14.13",
      "@types/bun": "^1.4.2",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@typescript/typescript6": "^6.0.2",
      "@vitejs/plugin-react": "^6.1.1",
      "@xterm/addon-fit": "^0.11.0",
      "@xterm/xterm": "^6.0.0",
      "clsx": "^2.1.1",
      "diff": "^9.0.0",
      "electron": "^44.0.0",
      "electron-builder": "^26.0.0",
      "electron-vite": "^5.0.0",
      "katex": "^0.18.9",
      "@lexical/react": "^0.52.0",
      "lexical": "^0.52.0",
      "lucide-react": "^1.49.0",
      "motion": "^13.4.6",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "react-grab": "^0.2.0",
      "shiki": "^4.4.3",
      "streamdown": "^2.6.0",
      "tailwind-merge": "^3.7.0",
      "tailwindcss": "^4.3.3",
      "turbo": "^2.11.5",
      "typescript": "^7.0.2",
      "uuid": "^14.0.2",
      "vite": "^8.3.1",
      "yaml": "^2.9.1",
      "yet-another-react-lightbox": "^3.32.2",
      "zod": "^4.6.5"
    },
    "catalogs": {}
  }
}
