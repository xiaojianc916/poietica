{
  "name": "poietica",
  "version": "0.5.17",
  "private": true,
  "description": "Poietica — 本地 AI agent 桌面应用",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaojianc916/poietica.git"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "features/*",
      "apps/*"
    ],
    "catalog": {
      "@base-ui/react": "^1.9.0",
      "@biomejs/biome": "^2.6.3",
      "@happy-dom/global-registrator": "^21.0.4",
      "@lydell/node-pty": "^1.2.0-beta.18",
      "@oh-my-pi/pi-ai": "18.12.6",
      "@oh-my-pi/pi-coding-agent": "18.12.6",
      "@oh-my-pi/pi-tui": "18.12.6",
      "@oh-my-pi/pi-utils": "18.12.6",
      "@streamdown/cjk": "^1.0.4",
      "@streamdown/code": "^2.0.0",
      "@streamdown/math": "^1.0.3",
      "@swc/core": "^1.16.20",
      "@tailwindcss/node": "^4.3.3",
      "@tailwindcss/vite": "^4.3.3",
      "@tanstack/react-virtual": "^3.14.22",
      "@testing-library/react": "^16.3.3",
      "@types/bun": "^1.4.4",
      "@types/hast": "^3.0.5",
      "@types/node": "26.6.5",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@vitejs/plugin-react": "^6.1.2",
      "@xterm/addon-fit": "^0.11.0",
      "@xterm/addon-web-links": "^0.12.0",
      "@xterm/xterm": "^6.0.0",
      "chart.js": "4.6.1",
      "clsx": "^2.1.1",
      "croner": "^10.0.1",
      "d3": "7.9.0",
      "dependency-cruiser": "^18.7.0",
      "diff": "^9.0.0",
      "electron": "^45.0.0",
      "electron-builder": "^26.18.0",
      "electron-updater": "^6.8.11",
      "electron-vite": "^6.0.0",
      "katex": "^0.19.1",
      "@lexical/react": "^0.52.0",
      "lexical": "^0.52.0",
      "lucide": "1.61.0",
      "lucide-react": "^1.61.0",
      "motion": "^14.6.0",
      "pele": "^1.10.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "shiki": "^4.5.0",
      "streamdown": "^2.7.1",
      "tailwind-merge": "^3.7.0",
      "tailwindcss": "^4.3.3",
      "typescript": "^7.0.2",
      "vite": "^8.3.5",
      "yet-another-react-lightbox": "^3.32.2",
      "zod": "^4.6.7",
      "zustand": "^5.0.16"
    }
  },
  "scripts": {
    "typecheck": "bun run tooling/refs/sync.ts --check && bun check -b && bun check -p tsconfig.tests.json",
    "refs": "bun run tooling/refs/sync.ts",
    "lint": "biome check --formatter-enabled=false . && bun run tooling/checks/no-biome-ignore.ts && bun run tooling/checks/editor-project-map.ts && bun run tooling/checks/manifest-deps.ts && bun run tooling/checks/style-boundaries.ts && bun run tooling/checks/conversation-shared-imports.ts && bun run check:omp-doc && depcruise --config tooling/depcruise/config.cjs tooling packages features apps",
    "test": "bun test",
    "all": "bun run typecheck && bun run format:check && bun run lint && bun run test",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "dev": "bun run core:build && bun run --filter @poietica/desktop dev",
    "core:build": "bun run apps/core/scripts/build.ts",
    "core:probe": "bun run apps/core/scripts/probe.ts",
    "core:verify-dist": "bun run apps/core/scripts/verify-dist.ts",
    "desktop:smoke": "bun run apps/desktop/scripts/smoke.ts",
    "protocol:snapshot": "bun run packages/protocol/scripts/write-snapshot.ts",
    "desktop:build": "bun run --filter @poietica/desktop build",
    "dist": "bun run --filter @poietica/desktop dist",
    "release": "bun run tooling/release/release.ts",
    "build:release": "bun run core:build && bun run core:verify-dist && bun run desktop:build && bun run desktop:package",
    "desktop:package": "bun run --filter @poietica/desktop package",
    "check:versions": "bun run tooling/release/check-versions.ts",
    "check:ticker": "bun run tooling/checks/ticker-layout/run.ts",
    "check:review-page": "bun run tooling/checks/review-page/run.ts",
    "latest-json": "bun run tooling/release/latest-json.ts",
    "verify:channel": "bun run tooling/release/verify-channel.ts",
    "version:set": "bun run tooling/release/set-version.ts",
    "desktop:dev": "bun run --filter @poietica/desktop dev",
    "new:package": "bun run tooling/scaffold/new-package.ts",
    "new:feature": "bun run tooling/scaffold/new-feature.ts",
    "python:pin": "bun run features/python/scripts/pin-python.ts",
    "check:omp-doc": "bun run tooling/checks/omp-sdk-doc.ts",
    "check:omp-doc:write": "bun run tooling/checks/omp-sdk-doc.ts --write"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@happy-dom/global-registrator": "catalog:",
    "@swc/core": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "dependency-cruiser": "catalog:",
    "typescript": "catalog:",
    "@poietica/fs-kit": "workspace:*",
    "@poietica/runtime-layout": "workspace:*"
  }
}
