{
  "name": "poietica",
  "version": "0.5.0",
  "private": true,
  "description": "Poietica — 本地 AI agent 桌面应用",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaojianc916/poietica.git"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "features/*",
      "apps/*"
    ],
    "catalog": {
      "@base-ui/react": "^1.8.0",
      "@biomejs/biome": "^2.5.15",
      "@happy-dom/global-registrator": "^20.14.5",
      "@lydell/node-pty": "^1.1.0",
      "@oh-my-pi/pi-ai": "18.5.0",
      "@oh-my-pi/pi-coding-agent": "18.5.0",
      "@oh-my-pi/pi-tui": "18.5.0",
      "@oh-my-pi/pi-utils": "18.5.0",
      "@streamdown/cjk": "^1.0.4",
      "@streamdown/code": "^2.0.0",
      "@streamdown/math": "^1.0.3",
      "@streamdown/mermaid": "^1.0.3",
      "@swc/core": "^1.13.0",
      "@tailwindcss/vite": "^4.3.3",
      "@tanstack/react-virtual": "^3.14.13",
      "@testing-library/react": "^16.3.0",
      "@types/bun": "^1.4.2",
      "@types/node": "^24.0.0",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@vitejs/plugin-react": "^6.1.1",
      "@xterm/addon-fit": "^0.11.0",
      "@xterm/addon-web-links": "^0.12.0",
      "@xterm/xterm": "^6.0.0",
      "clsx": "^2.1.1",
      "croner": "^10.0.1",
      "dependency-cruiser": "^18.5.0",
      "diff": "^9.0.0",
      "electron": "^44.5.1",
      "electron-builder": "^26.15.3",
      "electron-updater": "^6.8.9",
      "electron-vite": "^5.0.0",
      "katex": "^0.19.0",
      "@lexical/react": "^0.52.0",
      "lexical": "^0.52.0",
      "lucide-react": "^1.50.0",
      "motion": "^14.0.0",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "shiki": "^4.5.0",
      "streamdown": "^2.7.0",
      "tailwind-merge": "^3.7.0",
      "tailwindcss": "^4.3.3",
      "typescript": "^7.0.2",
      "vite": "^8.3.2",
      "yaml": "^2.9.1",
      "yet-another-react-lightbox": "^3.32.2",
      "zod": "^4.6.5",
      "zustand": "^5.0.8"
    }
  },
  "scripts": {
    "typecheck": "bun run tooling/refs/sync.ts --check && bun check -b && bun check -p tsconfig.tests.json",
    "refs": "bun run tooling/refs/sync.ts",
    "lint": "biome check . && bun run tooling/checks/no-raw-errors.ts && bun run tooling/checks/no-biome-ignore.ts && bun run tooling/checks/editor-project-map.ts && depcruise --config tooling/depcruise/config.cjs tooling packages features apps",
    "test": "bun test",
    "all": "bun run typecheck && bun run lint && bun run test",
    "format": "biome check --write .",
    "dev": "bun run core:build && bun run --filter @poietica/desktop dev",
    "core:build": "bun run apps/core/scripts/build.ts",
    "core:probe": "bun run apps/core/scripts/probe.ts",
    "core:verify-dist": "bun run apps/core/scripts/verify-dist.ts",
    "desktop:smoke": "bun run apps/desktop/scripts/smoke.ts",
    "protocol:snapshot": "bun run packages/protocol/scripts/write-snapshot.ts",
    "desktop:build": "bun run --filter @poietica/desktop build",
    "dist": "bun run --filter @poietica/desktop dist",
    "release": "bun run tooling/release/release.ts",
    "build:release": "bun run core:build && bun run core:verify-dist && bun run desktop:build && bun run desktop:package",
    "desktop:package": "bun run --filter @poietica/desktop package",
    "check:versions": "bun run tooling/release/check-versions.ts",
    "latest-json": "bun run tooling/release/latest-json.ts",
    "verify:channel": "bun run tooling/release/verify-channel.ts",
    "version:set": "bun run tooling/release/set-version.ts",
    "desktop:dev": "bun run --filter @poietica/desktop dev",
    "new:package": "bun run tooling/scaffold/new-package.ts",
    "new:feature": "bun run tooling/scaffold/new-feature.ts",
    "python:pin": "bun run scripts/pin-python.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@happy-dom/global-registrator": "catalog:",
    "@swc/core": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:"
  }
}
