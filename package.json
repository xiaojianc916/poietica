{
  "name": "poietica",
  "version": "0.2.7",
  "private": true,
  "description": "Poietica — a local-first AI agent desktop environment for thinking, describing, and creating.",
  "license": "SEE LICENSE IN THIRD_PARTY_NOTICES.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaojianc916/poietica.git"
  },
  "bugs": {
    "url": "https://github.com/xiaojianc916/poietica/issues"
  },
  "homepage": "https://github.com/xiaojianc916/poietica#readme",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "audit": "bun audit --audit-level=high",
    "audit:rust": "cargo deny check --all-features",
    "build:debug": "bun run --filter @poietica/desktop tauri:build:debug",
    "build:release": "bun run --filter @poietica/desktop tauri:build:release",
    "build:web": "turbo run build",
    "check": "bun run check:web && bun run check:rust",
    "check:rust": "cargo fmt --all -- --check && bun run clippy && bun run test:rust && bun run ipc:check && bun run kap:generated:check",
    "check:versions": "bun tools/release/check-versions.ts",
    "check:web": "biome ci . && bun tools/architecture/verify.ts && turbo run typecheck test --continue",
    "clean": "bun tools/dev/clean.ts",
    "clippy": "CARGO_INCREMENTAL=0 cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "dev": "bun run --filter @poietica/desktop tauri:dev",
    "format": "biome format --write .",
    "ipc:check": "bun tools/contract/check-generated.ts",
    "ipc:generate": "bun tools/contract/generate-ipc.ts",
    "kap:generate": "bun tools/contract/generate-kap.ts",
    "kap:generated:check": "bun tools/contract/check-kap.ts",
    "kap:spec": "bun tools/contract/kap-spec-sync.ts",
    "kap:spec:check": "bun tools/contract/kap-spec-sync.ts --check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "perf": "bun run --filter @poietica/tests perf",
    "prepare": "bun tools/dev/install-git-hooks.ts",
    "release": "bun tools/release/release.ts",
    "test": "turbo run test",
    "test:architecture": "bun tools/architecture/verify.ts",
    "test:rust": "cargo test --workspace --all-features",
    "typecheck": "turbo run typecheck --continue",
    "verify:channel": "bun tools/release/verify-channel.ts",
    "version:set": "bun tools/release/set-version.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/typescript6": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tests",
      "tools"
    ],
    "catalog": {
      "@base-ui/react": "1.7.0",
      "@biomejs/biome": "2.5.10",
      "@streamdown/cjk": "1.0.3",
      "@streamdown/code": "1.1.1",
      "@streamdown/math": "1.0.2",
      "@streamdown/mermaid": "1.0.2",
      "@tailwindcss/vite": "4.3.3",
      "@tanstack/react-virtual": "3.14.10",
      "@types/bun": "1.4.0",
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.4",
      "@typescript/typescript6": "6.0.2",
      "@vitejs/plugin-react": "6.1.0",
      "@xterm/addon-fit": "0.10.0",
      "@xterm/xterm": "5.5.0",
      "clsx": "2.1.1",
      "diff": "9.0.0",
      "katex": "0.18.4",
      "@lexical/react": "0.49.0",
      "lexical": "0.49.0",
      "lucide-react": "1.33.0",
      "motion": "13.1.1",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "react-grab": "0.2.0",
      "shiki": "4.2.0",
      "streamdown": "2.6.0",
      "tailwind-merge": "3.6.0",
      "tailwindcss": "4.3.3",
      "turbo": "2.10.11",
      "typescript": "7.0.2",
      "uuid": "14.0.2",
      "valibot": "1.4.2",
      "vite": "8.2.2",
      "yaml": "2.9.0",
      "yet-another-react-lightbox": "3.32.2"
    },
    "catalogs": {
      "tauri": {
        "@tauri-apps/api": "2.11.1",
        "@tauri-apps/cli": "2.11.4",
        "@tauri-apps/plugin-clipboard-manager": "2.3.2",
        "@tauri-apps/plugin-dialog": "2.7.2",
        "@tauri-apps/plugin-fs": "2.5.1",
        "@tauri-apps/plugin-global-shortcut": "2.3.2",
        "@tauri-apps/plugin-notification": "2.3.3",
        "@tauri-apps/plugin-process": "2.3.1",
        "@tauri-apps/plugin-shell": "2.3.5",
        "@tauri-apps/plugin-updater": "2.11.0"
      }
    }
  }
}
