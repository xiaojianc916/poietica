{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.tsbuild",
      "!**/dist",
      "!**/out",
      "!**/dist-release",
      "!apps/desktop/release",
      "!**/coverage",
      "!**/*.snap",
      "!packages/protocol/src/__tests__/contract.snapshot.json",
      "!**/*.svg",
      "!**/*.min.js",
      "!docs/baseline"
    ],
    "maxSize": 2097152
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "json": {
    "parser": {
      "allowComments": false,
      "allowTrailingCommas": false
    }
  },
  "plugins": [
    {
      "path": "./tooling/checks/raw-errors.grit",
      "includes": [
        "**/features/**/*.ts",
        "**/features/**/*.tsx",
        "!**/features/**/__tests__/**",
        "!**/features/**/*.test.ts",
        "!**/features/**/*.test.tsx"
      ]
    },
    {
      "path": "./tooling/checks/wildcard-modules.grit",
      "includes": [
        "**/*.ts",
        "**/*.tsx",
        "!**/tooling/tsconfig/css-imports.d.ts",
        "!**/tooling/tsconfig/raw-imports.d.ts"
      ]
    },
    {
      "path": "./tooling/checks/service-cast.grit",
      "includes": [
        "**/features/**/*.ts",
        "**/features/**/*.tsx",
        "**/packages/**/*.ts",
        "**/packages/**/*.tsx",
        "!**/__tests__/**"
      ]
    }
  ],
  "css": {
    "parser": {
      "cssModules": false,
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error",
        "noDoubleEquals": "error"
      },
      "style": {
        "useImportType": "error",
        "useExportType": "error",
        "noNonNullAssertion": "off",
        "useNodejsImportProtocol": "error",
        "noDefaultExport": "off",
        "useThrowOnlyError": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "complexity": {
        "noBannedTypes": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/transcript/src/ops/apply.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 30
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "features/conversation/src/ui/home/mascot/engine-runtime/ball.ts",
        "features/conversation/src/ui/home/mascot/engine-runtime/emotions.ts",
        "features/conversation/src/ui/home/mascot/engine-runtime/engine.ts",
        "features/conversation/src/ui/home/mascot/engine-runtime/rings.ts",
        "features/conversation/src/ui/home/mascot/engine-runtime/types.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 25
              }
            }
          }
        }
      }
    },
    {
      "includes": ["features/automations/src/core/__tests__/agent-tools.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": [
        "tooling/**",
        "features/*/scripts/**",
        "apps/*/scripts/**",
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["features/terminal/src/ui/terminal-pane.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/design-system/src/settings.css", "packages/design-system/src/tokens/accessibility.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          },
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/foundation/src/last-resort.ts",
        "packages/logging/src/console-sink.ts",
        "packages/test-kit/src/test-logger.ts",
        "packages/ui-kernel/src/services/logging.ts",
        "packages/engine-omp/src/bootstrap/stdout-guard.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "features/automations/src/ui/automation-editor.tsx",
        "features/automations/src/ui/index.tsx",
        "features/browser/src/host/picker-runtime.ts",
        "features/browser/src/host/relay-client.ts",
        "features/browser/src/ui/tool-card.tsx",
        "features/conversation/src/ui/home/assistant-surface.tsx",
        "features/conversation/src/ui/composer/view/composer-palette.tsx",
        "features/conversation/src/ui/composer/view/prompt-input.tsx",
        "features/conversation/src/ui/composer/view/session-controls.tsx",
        "features/conversation/src/ui/timeline/feed/agent-activity-feed.tsx",
        "features/conversation/src/ui/home/home-surface.tsx",
        "features/conversation/src/ui/home/mascot/emotion-ball.tsx",
        "features/conversation/src/ui/shared/semantics/tool-call-facets.ts",
        "features/conversation/src/ui/timeline/presentation.ts",
        "features/conversation/src/ui/timeline/timeline-queries.ts",
        "features/conversation/src/ui/timeline/model/transcript-replica.ts",
        "features/conversation/src/ui/timeline/model/transcript-store.ts",
        "features/models/src/ui/models-settings.tsx",
        "features/platform/src/host/storage-service.ts",
        "packages/engine-testkit/src/conformance.ts",
        "packages/host-kernel/src/core-supervisor.ts",
        "tooling/refs/sync.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 20
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "features/conversation/src/ui/session/session-port.ts",
        "features/extensions/src/ui/mcp-config.ts",
        "packages/engine-omp/src/projector/__tests__/fixtures/live.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 25
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "features/conversation/src/ui/setup/contributions.tsx",
        "features/models/src/ui/catalog-port.ts",
        "packages/logging/src/redact.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 30
              }
            }
          }
        }
      }
    },
    {
      "includes": ["features/conversation/src/core/repository.ts", "packages/git/src/parse.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 40
              }
            }
          }
        }
      }
    },
    {
      "includes": ["features/python/src/core/installer.ts", "packages/contract-kit/src/compose.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 52
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
