{
  "name": "@poietica/desktop",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test src electron",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck:browser": "tsc --project tsconfig.json --noEmit",
    "typecheck:electron": "tsc --project electron/tsconfig.json --noEmit",
    "typecheck:node": "tsc --project tsconfig.node.json --noEmit",
    "electron:dev": "bun run native:build && electron-vite dev",
    "electron:build": "electron-vite build",
    "electron:picker": "bun build src/browser/element-picker-runtime.ts --outdir dist-electron --entry-naming element-picker.js --target=browser --format=iife --minify",
    "electron:smoke": "node electron/smoke.mjs",
    "typecheck": "bun run typecheck:browser && bun run typecheck:electron && bun run typecheck:node",
    "electron:package": "electron-builder --win nsis",
    "native:build": "bun run ../../tools/dev/build-native.ts"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@poietica/agent-catalog": "workspace:*",
    "@poietica/automation": "workspace:*",
    "@poietica/conversation": "workspace:*",
    "@poietica/design-system": "workspace:*",
    "@poietica/extension": "workspace:*",
    "@poietica/external-store": "workspace:*",
    "@poietica/native-bridge": "workspace:*",
    "@poietica/problem": "workspace:*",
    "@poietica/review": "workspace:*",
    "@poietica/settings": "workspace:*",
    "@poietica/terminal": "workspace:*",
    "@poietica/update": "workspace:*",
    "@poietica/workspace": "workspace:*",
    "@streamdown/mermaid": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-grab": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "uuid": "catalog:",
    "vite": "catalog:",
    "zod": "catalog:"
  },
  "main": "dist-electron/main.cjs"
}
