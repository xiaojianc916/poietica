{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poietica",
  "version": "0.1.6",
  "identifier": "com.poietica.Poietica",
  "build": {
    "beforeDevCommand": "pnpm --filter @poietica/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @poietica/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Poietica",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "backgroundColor": "#f3f3f3",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --enable-features=RemoveRedirectionBitmap,msWebView2EnableDraggableRegions"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: poietica-asset: http://poietica-asset.localhost https://poietica-asset.localhost; font-src 'self' data:; media-src 'self' poietica-asset: http://poietica-asset.localhost https://poietica-asset.localhost; object-src 'none'; base-uri 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; frame-src 'self'; frame-ancestors 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Poietica Contributors",
    "copyright": "Copyright (c) 2026 Poietica Contributors",
    "homepage": "https://github.com/xiaojianc916/poietica",
    "shortDescription": "Local-first AI agent desktop environment for thinking and creating.",
    "longDescription": "Poietica is a local-first AI agent desktop environment. Runs and conversations stay on your machine; AI assistance is opt-in per session.",
    "licenseFile": "../../../LICENSE",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installerHooks": "installer-hooks.nsh",
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true,
        "compression": "lzma"
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/xiaojianc916/poietica/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExNTRBRDgxQzU3NDZCNzMKUldSemEzVEZnYTFVRWMwZTl4MHZsVUNLZ3d5bElPcG5ObEJoN1pkdGp5ZWQ1a29RL3lpbzBZRngK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
